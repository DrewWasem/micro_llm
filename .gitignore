# macOS
.DS_Store

# Claude Code state stays on this machine because the repo is public.
# .claude/ holds the memory tree, hooks, subagent output and local settings;
# .tasks/ holds task tickets. CLAUDE.md at the root is committed.
.claude/
.tasks/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Model weights and checkpoints: large binaries stay out of git
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.pkl
*.joblib

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# HTML rendered from markdown for local review
README.html
CLAUDE.html
docs/**/*.html
# These pages have no markdown source: two are hand-built and scripts/pipeline_diagram.py draws the third
!docs/pipeline.html
!docs/sample_run.html
!docs/sample_run_flow.html

# data/ is committed so every result can be checked. The resolve step's thread store is runtime state.
data/threads.sqlite

# Trained models stay on this machine; their scores are committed
models/*
!models/eval.json
!models/RESULTS.md
